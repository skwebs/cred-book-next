{
  "name": "cred-book",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:export:sqlite": "python scripts/export-sqlite.py",
    "db:import:neon": "node scripts/import-neon.mjs",
    "test:billing": "node scripts/test-billing.mjs",
    "db:migrate:apply": "node scripts/migrate-db.mjs --apply",
    "dev:webpack": "next dev --webpack --hostname 0.0.0.0",
    "build:webpack": "next build --webpack"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@tanstack/react-query": "^5.107.1",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^1.72.0",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/busboy": "^1.5.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "core-js@3.51.0": true
  }
